# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Project documentation (local-only)
# Ignore the documentation text and any variant with this prefix
WVSU_SPACE_DOCUMENTATION*
# Ignore the local PDF (name includes a space)
WVSU SPACE_1.pdf
WVSU Space_1.pdf

# Local docs folder (ignore entire directory)
/docs/

# Secrets and credentials (prevent accidental leaks)
# Environment files
.env
.env.*
*.env
.envrc
*.secret
*.secrets
secrets/
# Allow a tracked template for environment variables
!/.env.example

# Firebase/Google config (often contain API keys)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
**/serviceAccount*.json
**/service_account*.json
**/*credentials*.json
**/*-credentials.json

# Android signing
android/key.properties
**/*.keystore
**/*.jks

# iOS signing and Apple keys/certs
**/*.p8
**/*.pem
**/*.cer
**/*.mobileprovision
**/*.p12
**/*.pfx

# Tooling configs that may contain tokens
.npmrc
.yarnrc
.pnpmrc

# Editor workspace (may hold local secrets)
.vscode/
