# Example environment configuration for local development
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# Firebase (Web / cross-platform)
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_APP_ID_WEB=
FIREBASE_APP_ID_WINDOWS=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

# Google Maps or other third-party APIs
MAPS_API_KEY=
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Notes:
# - This project currently uses firebase_options.dart generated by FlutterFire.
#   If you switch to runtime env loading, consider using `flutter_dotenv` and
#   mapping these values in your app bootstrap instead of committing platform configs.
# - Keep platform-specific files like google-services.json and GoogleService-Info.plist
#   out of version control. Place them locally and reference them via build steps.
