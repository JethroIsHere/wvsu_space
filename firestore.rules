rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
		function isSignedIn() { return request.auth != null; }
		function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

		// Collection group queries for admin moderation logs
		match /{path=**}/warnings/{warningId} {
			allow read: if isAdmin();
		}
		
		match /{path=**}/standing_reports/{reportId} {
			allow read: if isAdmin();
		}

		// Matchmaking queue: each user owns a doc with id == uid
				match /matchQueue/{uid} {
					// Anyone signed in can read to discover potential partners
					allow read: if isSignedIn();

					// Users manage their own queue doc normally
					allow create, update, delete: if isSignedIn() && uid == request.auth.uid;

					// Temporary client-side pairing support (for Spark/no billing): allow a
					// peer to transition another user's doc from waiting -> paired, but only
					// when partner is the caller and a sessionId is provided. This narrows
					// the write and mitigates abuse.
					allow update: if isSignedIn() &&
						uid != request.auth.uid &&
						resource.data.status == 'waiting' &&
						request.resource.data.status == 'paired' &&
						request.resource.data.sessionId is string &&
						request.resource.data.partner == request.auth.uid;
				}

		// Sessions and messages
				match /sessions/{sessionId} {
						// Only participants of the session can read the session document.
						allow read: if isSignedIn() &&
							request.auth.uid in resource.data.participants;

						// TEMP (dev fallback): allow clients to create a session doc when
						// performing client-side pairing. Restrict to:
						// - participants is a list of exactly 2 uids
						// - the caller is one of the participants
						// - mode is a string
						// Updates/deletes remain blocked.
						allow create: if isSignedIn() &&
							request.resource.data.participants is list &&
							request.resource.data.participants.size() == 2 &&
							request.auth.uid in request.resource.data.participants &&
							request.resource.data.mode is string;
						// Allow participants to mark the session as ended.
						allow update: if isSignedIn() &&
							request.auth.uid in resource.data.participants &&
							request.resource.data.status == 'ended' &&
							request.resource.data.endedBy == request.auth.uid;
						allow delete: if false;

					match /messages/{messageId} {
						// Only participants can read and write messages.
						allow read: if isSignedIn() &&
							request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants;
						allow create: if isSignedIn() &&
							request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants;
						// Disallow client updates/deletes of messages for integrity.
						allow update, delete: if false;
					}
				}

		// Reports: allow any signed-in user to submit; only admins can read/update
		match /reports/{id} {
			allow create: if isSignedIn();
			allow read: if isAdmin();
			allow update: if isAdmin();
			allow delete: if isAdmin();
		}

		// User-submitted reports (v2 path to avoid legacy triggers)
		match /user_reports/{id} {
			allow create: if isSignedIn();
			allow read: if isAdmin();
			allow update: if isAdmin();
			allow delete: if isAdmin();
		}

		// Admin review requests (appeals): users create; only admins can read/update
		match /admin_review_requests/{id} {
			allow create: if isSignedIn();
			allow read: if isAdmin();
			allow update: if isAdmin();
			allow delete: if false;
		}

		// Admin registry for incrementing labels
		match /admins/{adminId} {
			allow read, write: if isAdmin();
		}

		match /admins_meta/{docId} {
			allow read, write: if isAdmin();
		}

		// Ratings: allow any signed-in user to create a rating document.
		// Backend Cloud Function will process standing changes. No client reads needed.
		match /ratings/{id} {
			allow create: if isSignedIn();
			allow read, update, delete: if false;
		}

		// Users: allow admins to read user profiles (for moderation UI)
		// Also allow a user to read their own profile document.
		// Allow reading other users' docs for rating/report transactions
		match /users/{uid} {
			allow read: if isAdmin() || 
				(request.auth != null && request.auth.uid == uid) ||
				isSignedIn(); // Allow reading for transactions
			// Allow updating standing field only (for rating system)
			allow update: if isSignedIn() && 
				request.resource.data.diff(resource.data).affectedKeys().hasOnly(['standing']);
			// Allow users to update ONLY their own activity tracking fields
			// Accept either lastActiveAt alone or both lastActiveAt + legacy lastActive
			allow update: if isSignedIn() &&
				request.auth.uid == uid &&
				request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'lastActive']);
			// Allow admins to update any field (for warnings, suspensions, etc.)
			allow update: if isAdmin();
			// Allow creating user doc if it only contains standing and uid fields (for rating system initialization)
			allow create: if isSignedIn() && 
				request.resource.data.keys().hasOnly(['standing', 'uid']) &&
				request.resource.data.standing is number;
			allow delete: if false;
			
			// Allow clients to write standing_reports for rating/report tracking
			match /standing_reports/{reportId} {
				allow read: if request.auth != null && request.auth.uid == uid;
				allow create: if isSignedIn();
				allow update, delete: if false;
			}
			
			// Warnings subcollection: only admins can write, user can read their own
			match /warnings/{warningId} {
				allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
				// Allow admins to create warnings and score adjustment notifications
				allow create: if isAdmin();
				allow update, delete: if false;
			}
			
			// Suspensions subcollection: only admins can write, user can read their own
			match /suspensions/{suspensionId} {
				allow read: if request.auth != null && request.auth.uid == uid;
				allow create: if isAdmin();
				allow update, delete: if false;
			}
		}
	}
}
