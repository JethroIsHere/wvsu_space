rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    // Helper: user must be signed-in, email verified, and belong to WVSU domain
    function isVerifiedWvsu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^.+@wvsu\\.edu\\.ph$');
    }

    // Collection group queries for admin moderation logs
    match /{path=**}/warnings/{warningId} {
      allow read: if isAdmin();
    }

    match /{path=**}/standing_reports/{reportId} {
      allow read: if isAdmin();
    }

    // Matchmaking queue: each user owns a doc with id == uid
    match /matchQueue/{uid} {
      // Anyone signed in can read
      allow read: if isSignedIn();

      // Users manage their own queue doc
      allow create, update, delete: if isSignedIn() && uid == request.auth.uid;

      // Allow a peer to transition waiting -> paired with constraints
      allow update: if isSignedIn()
        && uid != request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'paired'
        && request.resource.data.sessionId is string
        && request.resource.data.partner == request.auth.uid;
    }

    // Sessions and messages
    match /sessions/{sessionId} {
      // Only participants of the session can read the session document.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      // TEMP (dev fallback): allow clients to create a session doc when
      // performing client-side pairing. Allow any signed-in user to create
      // a session (quick chat or interest matching) as long as they are one
      // of the participants. Client-side pairing remains constrained.
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.mode is string;

      // Allow participants to mark the session as ended.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.status == 'ended'
        && request.resource.data.endedBy == request.auth.uid;

      allow delete: if false;

      match /messages/{messageId} {
        // Only participants can read and write messages.
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants;
        // Allow create if caller is a session participant and basic validation passes.
        // Support either the older `timestamp`/`senderNickname` fields or the
        // session UI's `ts` field and optional nickname.
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && (
            // legacy format: senderNickname + timestamp
            (request.resource.data.senderNickname is string && request.resource.data.timestamp is timestamp)
            // or new session UI: ts (serverTimestamp) with optional senderNickname
            || (request.resource.data.ts is timestamp)
          );
        // Disallow client updates/deletes of messages for integrity.
        allow update, delete: if false;
      }
    }

    // Reports: only verified WVSU users may submit; only admins can read/update
    match /reports/{id} {
      allow create: if isVerifiedWvsu();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gratitude Wall posts: gratitude (permanent) and express (anonymous, expires)
    match /gratitude_posts/{postId} {
      // Public read so the wall is visible to everyone in the app
      allow read: if true;

      // Creating a post requires a verified WVSU account and basic validation
      allow create: if isVerifiedWvsu()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.type is string
        && (request.resource.data.type == 'gratitude' || request.resource.data.type == 'express')
        && request.resource.data.timestamp is timestamp
        && request.resource.data.isAnonymous is bool
        && (
          (request.resource.data.type == 'express' && request.resource.data.expiresAt is timestamp)
          || (request.resource.data.type == 'gratitude' && !request.resource.data.keys().hasAny(['expiresAt']))
        )
        && (request.resource.data.likes is number || !request.resource.data.keys().hasAny(['likes']));

      // Allow clients to update only the `likes` and `likedBy` fields (signed-in users),
      // or allow any signed-in user to backfill `expiresAt` when setting it to a
      // past/now timestamp (used by the refresh button to mark posts expired).
      allow update: if isSignedIn() && (
        // likes/likedBy updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','likedBy'])
        // or a one-time set of expiresAt to mark an expired post (must be <= server time)
        || (!resource.data.keys().hasAny(['expiresAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time)
      );

      // Allow owner to delete their own posts, or allow any signed-in user to delete an express post that has expired.
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.expiresAt is timestamp && resource.data.expiresAt <= request.time)
      );
    }

    // User-submitted reports (v2 path to avoid legacy triggers)
    match /user_reports/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admin review requests (appeals): users create; only admins can read/update
    match /admin_review_requests/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Admin registry for incrementing labels
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /admins_meta/{docId} {
      allow read, write: if isAdmin();
    }

    // Ratings: allow any signed-in user to create a rating document.
    // Backend Cloud Function will process standing changes. No client reads needed.
    match /ratings/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Vibe Rooms: public read, verified create, owner-only delete.
    match /vibe_rooms/{roomId} {
      // Public listing: anyone can read rooms
      allow read: if true;

      // Creating a room requires a signed-in user and the ownerUid must match the caller.
      // (Relaxed from verified-only so creators can persist rooms immediately.)
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.mood is string
        && request.resource.data.participantCount is int
        && request.resource.data.maxParticipants is int;

      // Allow updates for participant list changes or owner metadata edits.
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount','participants']))
        || (resource.data.ownerUid == request.auth.uid)
      );

      // Only the owner (creator) may delete the room.
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Presence subcollection: one doc per user (doc id == uid)
      match /presence/{uid} {
        // Allow anyone to read presence for UI convenience
        allow read: if true;

        // Allow the signed-in user themselves to create/update/delete their presence doc.
        // Presence is a low-risk client-side write used for active participant tracking.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastSeen', 'nickname'])
          && (request.resource.data.lastSeen is timestamp);

        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastSeen', 'nickname'])
          && (request.resource.data.lastSeen is timestamp);

        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      // Messages subcollection for rooms
      match /messages/{messageId} {
        // Public read so listings inside a room are visible; require auth to post.
        allow read: if true;
        // Allow signed-in participants to create messages. Basic validation on fields.
        // Require the caller to be the sender and a participant or the room owner.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.senderNickname is string
          && request.resource.data.timestamp is timestamp
          && (!request.resource.data.keys().hasAny(['isSystem']) || request.resource.data.isSystem is bool)
          && (
            request.auth.uid == get(/databases/$(database)/documents/vibe_rooms/$(roomId)).data.ownerUid
            || request.auth.uid in get(/databases/$(database)/documents/vibe_rooms/$(roomId)).data.participants
          );
        // Disallow client-side updates for integrity. Allow deletes only by the room owner.
        allow update: if false;
        // Allow the message sender or the room owner to delete a message.
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.senderId
          || request.auth.uid == get(/databases/$(database)/documents/vibe_rooms/$(roomId)).data.ownerUid
        );
      }
    }

    // Users: allow admins to read user profiles (for moderation UI)
    // Also allow a user to read their own profile document.
    // Allow reading other users' docs for rating/report transactions
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid) || isSignedIn();

      // Allow updating standing field only (for rating system)
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['standing']);

      // Allow users to update ONLY their own activity tracking fields
      allow update: if isSignedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'lastActive']);

      // Allow admins to update any field (for warnings, suspensions, etc.)
      allow update: if isAdmin();

      // Allow creating user doc if it only contains standing and uid fields (for rating system initialization)
      // OR allow normal client-side signup documents but enforce WVSU email domain.
      allow create: if isSignedIn() && (
        (
          request.resource.data.keys().hasOnly(['standing', 'uid']) &&
          request.resource.data.standing is number
        )
        || (
          request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.email is string
          && request.resource.data.email.matches('(^[^@\\s]+@wvsu\\.edu\\.ph$)|(^jet3danocup@gmail\\.com$)')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.standing is number
          && request.resource.data.keys().hasOnly(['nickname','email','createdAt','standing','uid'])
          // Only allow creating the normal user doc when the caller's email is verified
          && isVerifiedWvsu()
        )
      );

      allow delete: if false;

      // Allow clients to write standing_reports for rating/report tracking
      match /standing_reports/{reportId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      // Warnings subcollection: only admins can write, user can read their own
      match /warnings/{warningId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        // Allow admins to create warnings and score adjustment notifications
        allow create: if isAdmin();
        allow update, delete: if false;
      }

      // Suspensions subcollection: only admins can write, user can read their own
      match /suspensions/{suspensionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }
  }
}
